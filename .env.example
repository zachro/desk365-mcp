# Copy to .env (or <stage>.env, e.g. dev.env) and fill in your values.

# Your Desk365 API key: Settings > Integrations > API in Desk365.
API_KEY=

# Your Desk365 subdomain: the "yourcompany" in https://yourcompany.desk365.io
SUBDOMAIN=

# Optional. Email of the agent that replies and notes come from when the LLM
# doesn't name one. If unset, they come from the owner of the API key.
DEFAULT_AGENT_EMAIL=
